# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# one-shot PDF side extracts (canonical corpus is data/law.md)
data/*.extract.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep .env.example committed as the template
.env
.env.*
!.env.example

# local secrets / key material (defense in depth beyond .env.*)
*.key
secrets/

# vercel
.vercel

# IDE
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts
