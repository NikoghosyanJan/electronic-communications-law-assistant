# Pooled Neon URL for the app (hostname contains `-pooler`)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30"

# Direct (non-pooler) URL for Prisma migrate / db push — same credentials, no `-pooler`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=30"

# OpenAI — embeddings (text-embedding-3-large @ 1536-d) + gpt-4o-mini (+ eval judge)
OPENAI_API_KEY=

# Google Gemini — gemini-3.6-flash
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq Cloud — default qwen/qwen3.8-27b (https://console.groq.com)
GROQ_API_KEY=
# Optional override if your account has a different chat model:
# GROQ_MODEL=qwen/qwen3.8-27b

# xAI Grok — grok-4.3 (https://console.x.ai — NOT the same as Groq)
GROK_API_KEY=
# Optional alias used by some xAI docs:
# XAI_API_KEY=
